@startuml
' Base de datos - Notación Rails
' users y roles eliminados
' Los operarios mantienen user_id como referencia externa al sistema de autenticación

hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor #FEFECE
  BorderColor #A80036
}
skinparam arrow {
  Color #A80036
  FontColor #A80036
}
 
entity "clients" as clients {
  * id : bigint <<PK>>
  --
  name : string
  contact_name : string
  email : string <<nullable>>
  phone : string <<nullable>>
  address : text <<nullable>>
  notes : text <<nullable>>
  created_at : datetime
  updated_at : datetime
}

entity "client_workers" as client_workers {
  * id : bigint <<PK>>
  --
  user_id : bigint <<unique>> <<nullable>>
  names : string
  last_names : string
  email: string
  document : string <<nullable>>
  phone : string <<nullable>>
  certification : string <<nullable>>
  position : string <<nullable>>
  created_at : datetime
  updated_at : datetime
}

entity "workers" as workers {
  * id : bigint <<PK>>
  --
  user_id : bigint <<unique>> <<nullable>>
  names : string
  last_names : string
  email: string
  document : string <<nullable>>
  phone : string <<nullable>>
  certification : string <<nullable>>
  position : string <<nullable>>
  created_at : datetime
  updated_at : datetime
}

entity "brands" as brands {
  * id : bigint <<PK>>
  --
  name : string <<unique>>
  description : text
  created_at : datetime
  updated_at : datetime
}

entity "brand_models" as brand_models {
  * id : bigint <<PK>>
  --
  brand_id : bigint <<FK>>
  name : string
  description : text
  created_at : datetime
  updated_at : datetime
}

entity "machines" as machines {
  * id : bigint <<PK>>
  --
  client_id : bigint <<FK>>
  model_id : bigint <<FK>>
  name : string
  code : string
  serial_number : string
  machine_type : string
  location : string
  criticality : integer
  status : integer
  created_at : datetime
  updated_at : datetime
}

entity "oil_brands" as oil_brands {
  * id : bigint <<PK>>
  --
  name : string <<unique>>
  description : text
  created_at : datetime
  updated_at : datetime
}

entity "oil_types" as oil_types {
  * id : bigint <<PK>>
  --
  name : string <<unique>>
  description : text
  created_at : datetime
  updated_at : datetime
}

entity "oils" as oils {
  * id : bigint <<PK>>
  --
  oil_brand_id : bigint <<FK>>
  oil_type_id : bigint <<FK>>
  name : string
  description : text
  created_at : datetime
  updated_at : datetime
}

entity "machine_oils" as machine_oils {
  * id : bigint <<PK>>
  --
  machine_id : bigint <<FK>>
  oil_id : bigint <<FK>>
  created_at : datetime
  updated_at : datetime
}

entity "machine_documents" as machine_documents {
  * id : bigint <<PK>>
  --
  machine_id : bigint <<FK>>
  name : string
  description : text
  url : string
  document_type : string
  created_at : datetime
  updated_at : datetime
}

entity "samples" as samples {
  * id : bigint <<PK>>
  --
  machine_id : bigint <<FK>>
  client_operator_id : bigint <<FK>> <<nullable>>
  provider_operator_id : bigint <<FK>> <<nullable>>
  sampled_at : datetime
  sample_type : integer
  compartment : string
  sample_point : string
  oil_hours : decimal
  oil_km : decimal
  container_code : string <<unique>>
  viscosity_grade : string
  status : integer
  notes : text
  created_at : datetime
  updated_at : datetime
}

entity "analyses" as analyses {
  * id : bigint <<PK>>
  --
  sample_id : bigint <<FK>>
  provider_operator_id : bigint <<FK>>
  lab_name : string
  report_number : string
  received_at : datetime
  analyzed_at : datetime
  viscosity_40c : decimal
  viscosity_100c : decimal
  water_ppm : decimal
  fuel_percent : decimal
  glycol : boolean
  iron_ppm : decimal
  copper_ppm : decimal
  lead_ppm : decimal
  silicon_ppm : decimal
  tbn : decimal
  tan : decimal
  iso_code : string
  wear_severity : integer
  recommendation : text
  status : integer
  created_at : datetime
  updated_at : datetime
}

' ---------- Relaciones ----------

clients ||--o{ client_workers : "1:N"
clients ||--o{ machines : "1:N"

brands ||--o{ brand_models : "1:N"
brand_models ||--o{ machines : "1:N"

oil_brands ||--o{ oils : "1:N"
oil_types ||--o{ oils : "1:N"

machines ||--o{ machine_oils : "1:N"
oils ||--o{ machine_oils : "1:N"

machines ||--o{ machine_documents : "1:N"
machines ||--o{ samples : "1:N"

client_workers ||--o{ samples : "1:N"
workers ||--o{ samples : "1:N"
workers ||--o{ analyses : "1:N"

samples ||--o| analyses : "1:0..1"

@enduml